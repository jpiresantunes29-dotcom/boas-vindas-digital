# URL pública do site — usada em SEO (Open Graph, canonical, sitemap.xml).
# Deixe em branco em dev e enquanto não houver domínio próprio: cai
# automaticamente para o domínio *.vercel.app (via VERCEL_URL) ou localhost.
# Assim que o domínio final existir, defina aqui (ex: https://visitantes.suaigreja.com.br).
NEXT_PUBLIC_SITE_URL=

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — resend.com/api-keys (usado para notificar a equipe a cada novo cadastro)
RESEND_API_KEY=
# Endereço "de" usado no envio. Sem domínio próprio verificado no Resend,
# use o padrão de testes: onboarding@resend.dev
RESEND_EMAIL_REMETENTE=onboarding@resend.dev

# Quem recebe a notificação de novo cadastro (e-mail)
NOTIFICACAO_EMAIL_PRINCIPAL=
NOTIFICACAO_EMAIL_ADMIN=

# Evolution API — para notificações WhatsApp
# Documentação: https://docs.evolution.company/
# URL base da Evolution API (ex: https://sua-evolucao.com.br)
EVOLUTION_API_URL=
# Chave de autenticação da Evolution API
EVOLUTION_API_KEY=
# Nome da instância configurada na Evolution API
EVOLUTION_INSTANCE=
# Número de WhatsApp do responsável que recebe notificações de novo cadastro
NOTIFICACAO_WHATSAPP_NUMERO=
