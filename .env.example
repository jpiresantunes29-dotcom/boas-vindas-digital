# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — resend.com/api-keys (usado para notificar a equipe a cada novo cadastro)
RESEND_API_KEY=
# Endereço "de" usado no envio. Sem domínio próprio verificado no Resend,
# use o padrão de testes: onboarding@resend.dev
RESEND_EMAIL_REMETENTE=onboarding@resend.dev

# Quem recebe a notificação de novo cadastro
NOTIFICACAO_EMAIL_PRINCIPAL=
NOTIFICACAO_EMAIL_ADMIN=
