# URL pública do site — usada em SEO (Open Graph, canonical, sitemap.xml).
# Deixe em branco em dev e enquanto não houver domínio próprio: cai
# automaticamente para o domínio de produção *.vercel.app (via
# VERCEL_PROJECT_PRODUCTION_URL, definida pela própria Vercel) ou localhost.
# Assim que o domínio final existir, defina aqui (ex: https://visitantes.suaigreja.com.br).
NEXT_PUBLIC_SITE_URL=

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Chave SECRETA (service role): só no servidor, nunca commitar.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — resend.com/api-keys (usado para notificar a equipe a cada novo cadastro)
# Sem RESEND_API_KEY ou NOTIFICACAO_EMAIL_PRINCIPAL o e-mail é pulado (fica
# registrado no log) — o cadastro continua funcionando.
RESEND_API_KEY=
# Endereço "de" usado no envio. Sem domínio próprio verificado no Resend,
# use o padrão de testes: onboarding@resend.dev
RESEND_EMAIL_REMETENTE=onboarding@resend.dev

# Quem recebe a notificação de novo cadastro (e-mail)
NOTIFICACAO_EMAIL_PRINCIPAL=
NOTIFICACAO_EMAIL_ADMIN=

# Evolution API — notificações por WhatsApp (opcional)
# Documentação: https://doc.evolution-api.com/
# Se EVOLUTION_API_URL, EVOLUTION_API_KEY ou EVOLUTION_INSTANCE ficarem em
# branco, o envio por WhatsApp é simplesmente pulado — o cadastro e o e-mail
# continuam funcionando normalmente.
#
# URL base da sua instalação da Evolution API, sem barra no final
# (ex: https://evolution.suaigreja.com.br)
EVOLUTION_API_URL=
# Chave da Evolution API (enviada no header "apikey" de cada requisição)
EVOLUTION_API_KEY=
# Nome da instância (o WhatsApp conectado) criada na Evolution API
EVOLUTION_INSTANCE=
# WhatsApp do responsável que recebe o aviso de novo cadastro — só dígitos,
# COM DDI e DDD (ex: 5541999999999)
NOTIFICACAO_WHATSAPP_NUMERO=
